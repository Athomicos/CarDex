# --- PYTHON ---
# Descargas de librerías y entorno virtual
venv/
.venv/
env/
# Archivos temporales de compilación de Python
__pycache__/
*.py[cod]
*.egg-info/

# --- JAVASCRIPT / NODE.JS (Si llegas a usar paquetes/frameworks) ---
# Carpeta donde se descargan las librerías de JS
node_modules/
# Archivos generados en compilación/build
dist/
build/

# --- BASES DE DATOS Y SQL ---
# Ignora bases de datos locales (se regeneran con schema.sql + catalogo_seed.sql)
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
*.log

# --- SESIONES DE FLASK ---
# Archivos de sesión generados por Flask-Session (SESSION_TYPE="filesystem")
flask_session/

# --- FOTOS SUBIDAS POR USUARIOS ---
# Ignora el contenido pero mantiene la carpeta versionada (.gitkeep)
static/uploads/*
!static/uploads/.gitkeep

# --- CONFIGURACIÓN Y SECRETOS (Claves de API, contraseñas) ---
.env
.env.local

# --- SISTEMA OPERATIVO Y EDITORES DE CÓDIGO ---
.DS_Store
Thumbs.db
.vscode/
.idea/